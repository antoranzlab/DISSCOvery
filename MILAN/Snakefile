        method="{method}",
        seed=config["seed"],
        n_clusters=get_n_clusters_from_phenograph,
    log:
        os.path.join(PROJECT_DIR, "logs", "ci_cluster_{method}_csv.log"),
    threads: 1
    shell:
        "python {params.script} "
        "--input.marker.list {params.csv_markers} "
        "--path.input.csv {input.data} "
        "--path.output.csv {output.clusters} "
        "--clustering.method {params.method} "
        "--number.of.clusters {params.n_clusters} "
        "--selected.seed {params.seed} "
        "&> {log} "


# ---------------------------------------------------------------------------
# CSV aggregation
# ---------------------------------------------------------------------------

rule clustering_csv_done:
    input:
        all_clustering_csv_flags
    output:
        done=touch(CLUSTERING_CSV_DONE),
    log:
        os.path.join(PROJECT_DIR, "logs", "ci_clustering_csv.log" ),

