# ---------------------------------------------------------------------------
# 02 FFC - Hard stitching joblist 
# ---------------------------------------------------------------------------
checkpoint ffc_hs_joblist:
    input:
        extraction_done=EXTRACTION_DONE,
    output:
        joblist=CSV_02_HS_FFC_JOBLIST,
    params:
        script=os.path.join(config["scripts"], "src/03_hard_stitching/hard_stitching_list_jobs.py"),
        tiles_dir=PATH_01_RAW_TILES,
        out_dir=PATH_02_HS_RAW,
        pixel_size=config["hs_pixel_size"],
        dapi=config["ffc_only_dapi"],
    log:
        os.path.join(PROJECT_DIR, "logs", "hs_joblist.log"),
    shell:
        "python {params.script} "
        "--input_path_tiles {params.tiles_dir} " 
        "--input_path_meta {params.tiles_dir} " 
        "--output_folder {params.out_dir} " 
        "--output_path_csv {output.joblist} " 
        "--output_pixel_size {params.pixel_size} " 
        "--only_dapi {params.dapi} " 
        "--skip_existing False " # relevant only if run externally, snakemake overwrites the previous output (if created)
        "&> {log} "

# ---------------------------------------------------------------------------
# 02 FFC - Hard stitching RAW
# ---------------------------------------------------------------------------
def get_ffc_hs_jobs():
    df = pd.read_csv(checkpoints.ffc_hs_joblist.get().output.joblist)
    return {
        str(i): {
            "input_path_tiles": row["input_path_tiles"],
            "input_path_meta": row["input_path_meta"],
            "conversion_factor": row["conversion_factor"],
            "output_folder": row["output_folder"],
            "only_dapi": row["only_dapi"],
            "skip_existing": row["skip_existing"],
            }
        for i, row in df.iterrows()
    }

def all_ffc_hs_job_ids(wildcards):
    return list(get_ffc_hs_jobs().keys())

def all_ffc_hs_flags(wildcards):
    jobs = get_ffc_hs_jobs()
    return [
        os.path.join(PROJECT_DIR, "logs", f"ffc_hs_{j}.done")
        for j in jobs
    ]

wildcard_constraints:
    job=r"\d+"

rule hard_stitching:
    input:
        joblist=CSV_02_HS_FFC_JOBLIST,
    output:
        done=touch(os.path.join(PROJECT_DIR, "logs", "ffc_hs_{job}.done")),
    params:
        script=os.path.join(config["scripts"], "src/03_hard_stitching/hard_stitching.py"),
        tile=lambda wc: get_ffc_hs_jobs()[wc.job]["input_path_tiles"],
        meta=lambda wc: get_ffc_hs_jobs()[wc.job]["input_path_meta"],
        out_dir=lambda wc: get_ffc_hs_jobs()[wc.job]["output_folder"],
        conversion_factor=lambda wc: get_ffc_hs_jobs()[wc.job]["conversion_factor"],
        only_dapi=lambda wc: get_ffc_hs_jobs()[wc.job]["only_dapi"],
        skip_existing=lambda wc: get_ffc_hs_jobs()[wc.job]["skip_existing"],
    log:
        os.path.join(PROJECT_DIR, "logs", "ffc_hs_{job}.log"),
    threads: 1
    shell:
        "python {params.script} "
        "--input_tiles {params.tile} "
        "--input_meta {params.meta} "
        "--output_folder {params.out_dir} "
        "--conversion_factor {params.conversion_factor} "
        "--only_dapi {params.only_dapi} "
        "--skip_existing {params.skip_existing} "
        "&> {log} "

# Aggregator: forces checkpoint resolution and collects all per-job outputs
rule ffc_hs_done:
    input:
        all_ffc_hs_flags
    output:
        touch(FFC_HS_DONE),
    log:
        os.path.join(PROJECT_DIR, "logs", "ffc_hard_stitching.log"),
        
