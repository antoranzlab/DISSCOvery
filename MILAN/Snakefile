def get_generate_masks_jobs():
    df = pd.read_csv(checkpoints.mask_joblist.get().output.joblist)
    return {
        str(i): {
            "input_image": row["input_image"],
            "output_image": row["output_image"],
            "model": row["model"],
            }
        for i, row in df.iterrows()
    }

def all_generate_masks_job_ids(wildcards):
