CLUSTERING_METHODS = ["kmeans", "som"]

wildcard_constraints:
    method="|".join(CLUSTERING_METHODS)


def get_n_clusters_from_phenograph(wildcards):
    df = pd.read_parquet( os.path.join(PATH_REDUCED_DATA,"phenograph.parquet"))
    return df["cluster"].nunique()


def all_clustering_flags(wildcards):
    return expand(os.path.join(PROJECT_DIR,"logs", "ci_{method}_done.flag"),
        method=CLUSTERING_METHODS)

rule cluster_other_methods:
    input:
        data=CSV_11_DATA_SAMPLED,
        phenograph=os.path.join(PATH_REDUCED_DATA, "phenograph.parquet"),
    output:
        clusters=os.path.join(PATH_REDUCED_DATA, "{method}.parquet"),
        done=touch(os.path.join( PROJECT_DIR,"logs", "ci_{method}_done.flag")),
    params:
        script=os.path.join(config["scripts"],"src/11_cell_identification/Clustering.py"),
        csv_markers=os.path.join(PROJECT_DIR,"phenotypic_markers.csv"),
        method="{method}",
        seed=config["seed"],
        n_clusters=get_n_clusters_from_phenograph,
    log:
        os.path.join(PROJECT_DIR,"logs","ci_cluster_{method}.log"),
    threads: 1
    shell:
        "python {params.script} "
        "--input.marker.list {params.csv_markers} "
        "--path.input.csv {input.data} "
        "--path.output.csv {output.clusters} "
        "--clustering.method {params.method} "
        "--number.of.clusters {params.n_clusters} "
        "--selected.seed {params.seed} "
        "&> {log} "

