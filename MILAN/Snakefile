# 02 FFC - Copy raw files when needed
# ---------------------------------------------------------------------------
def get_ffc_raw_jobs():
    df = pd.read_csv(checkpoints.ffc_joblist.get().output.joblist)
    df = df[df['method']=='RAW']
    return {
        str(i): {
            "input_path": row["input_path"],
