    input:
        joblist=CSV_02_FFC_MASK_JOBLIST,
    output:
        done=touch(os.path.join(PROJECT_DIR, "logs", "generate_masks_{job}.done")),
    params:
        script=os.path.join(config["scripts"], "src/04_STS/STS_generate_mask.py"),
        input_file=lambda wc: get_generate_masks_jobs()[wc.job]["input_image"],
        output_file=lambda wc: get_generate_masks_jobs()[wc.job]["output_image"],
        model=lambda wc: get_generate_masks_jobs()[wc.job]["model"],
    log:
        os.path.join(PROJECT_DIR, "logs", "generate_masks_{job}.log"),
    threads: 1
    shell:
        "python {params.script} "
        "--input_image_path {params.input_file} "
        "--output_image_path {params.output_file} "
        "--model_path {params.model} "
        "&> {log} "

# Aggregator: forces checkpoint resolution and collects all per-job outputs
