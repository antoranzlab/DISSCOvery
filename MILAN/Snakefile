# ---------------------------------------------------------------------------
# 01 File parsing - Input QC
# ---------------------------------------------------------------------------
rule input_qc:
    input:
        indir=BASE_INPUT_DIR,
    output:
        txt=OUTPUT_01_QC_FILE,
    params:
        script=os.path.join(config["scripts"], "src/01_file_parser/czi_files_qc.py"),
    log:
        os.path.join(PROJECT_DIR, "logs", "input_qc.log"),
    shell:
        "python {params.script} "
        "--directory {input.indir} "
        "--output_txt {output.txt} "
        "&> {log}"

# ---------------------------------------------------------------------------
# 01 File parsing - Experimental design
# ---------------------------------------------------------------------------
rule experimental_design:
    input:
        indir=BASE_INPUT_DIR,
    output:
        channels=CSV_01_CHANNEL_NAMES,
        slides=CSV_01_EXP_DESIGN_SLIDES,
    params:
        script=os.path.join(config["scripts"], "src/01_file_parser/czi_extract_channel_metadata.py"),
    log:
        os.path.join(PROJECT_DIR, "logs", "experimental_design.log"),
    shell:
        "python {params.script} "
        "--directory {input.indir} "
        "--output_csv_channels {output.channels} "
        "--output_csv_slides {output.slides} "
        "&> {log}"

# ---------------------------------------------------------------------------
# 01 File parsing - Build the CZI extraction joblist
# ---------------------------------------------------------------------------
checkpoint generate_joblist:
    input:
        channels=CSV_01_CHANNEL_NAMES,
    output:
        joblist=CSV_01_EXTRACT_CZI_JOBLIST,
    params:
        script=os.path.join(config["scripts"], "src/01_file_parser/czi_generate_csv_joblist.py"),
        indir=BASE_INPUT_DIR,
        tiles_dir=PATH_01_RAW_TILES,
    log:
        os.path.join(PROJECT_DIR, "logs", "generate_joblist.log"),
    shell:
        "python {params.script} "
        "--path.input.folder {params.indir} " 
        "--path.input.channel.dictionary {input.channels} " 
        "--path.output.folder {params.tiles_dir} " 
        "--path.output.csv {output.joblist} " 
        "&> {log}"


# ---------------------------------------------------------------------------
# 01 File parsing - Run the CZI extraction orchestrator
# ---------------------------------------------------------------------------
# def _load_jobs_df():
#     csv_file = checkpoints.generate_joblist.get().output.joblist
#     return pd.read_csv(csv_file)
# 
# def get_extraction_jobs():
#     df = _load_jobs_df()
#     return {
#         str(i): {
#             "input_path": row["input_path"],
#             "output_folder": row["output_folder"],
#             "channel_dictionary": row["input_channel_dictionary"],
#         }
#         for i, row in df.iterrows()
#     }

def get_extraction_jobs():
    df = pd.read_csv(checkpoints.generate_joblist.get().output.joblist)
    return {
        str(i): {
            "input_path": row["input_path"],
            "output_folder": row["output_folder"],
            "channel_dictionary": row["input_channel_dictionary"],
        }
        for i, row in df.iterrows()
    }

def all_job_ids(wildcards):
    return list(get_extraction_jobs().keys())

def all_extraction_flags(wildcards):
    jobs = get_extraction_jobs()
    return [
        os.path.join(PROJECT_DIR, "logs", f"extract_czi_{j}.done")
        for j in jobs
    ]

wildcard_constraints:
    job=r"\d+"

rule extract_czi:
    input:
        joblist=CSV_01_EXTRACT_CZI_JOBLIST,
    output:
        done=touch(os.path.join(PROJECT_DIR, "logs", "extract_czi_{job}.done")),
    params:
        script=os.path.join(config["scripts"], "src/01_file_parser/czi_reader.py"),
        file=lambda wc: get_extraction_jobs()[wc.job]["input_path"],
        channel_dictionary=lambda wc: get_extraction_jobs()[wc.job]["channel_dictionary"],
        out_dir=lambda wc: get_extraction_jobs()[wc.job]["output_folder"],
        workers=config['num_workers']
    log:
        os.path.join(PROJECT_DIR, "logs", "extract_czi_{job}.log"),
    threads: 1
    shell:
        "python {params.script} "
        "--imfilename {params.file} "
        "--channel_names_dictionary {params.channel_dictionary} "
        "--output_folder {params.out_dir} "
        "--n_worker {params.workers}"
        "&> {log} "
        
# Aggregator: forces checkpoint resolution and collects all per-job outputs
rule extraction_done:
    input:
        all_extraction_flags
    output:
        touch(EXTRACTION_DONE),
    log:
        os.path.join(PROJECT_DIR, "logs", "extraction_done.log"),
        
