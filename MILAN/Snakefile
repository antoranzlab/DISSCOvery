# ---------------------------------------------------------------------------
# 08 AFS - add slide_id to exp_design_rounds
# ---------------------------------------------------------------------------
rule add_slide_id:
    input:
        align_done = MERGE_DONE,
    output:
        id_done = touch(SLIDE_ID_SELECTION_DONE),
    params:
        exp_design=config["exp_design_rounds"],
        exp_slides=CSV_01_EXP_DESIGN_SLIDES,
    run:
        import pandas as pd

        # Experimental design for rounds/versions
        df_exp_design = pd.read_csv(params.exp_design)

        # Experimental design for slides
        df_exp_slide = pd.read_csv(params.exp_slides)

        # Add every slide_id to every R/V combination
        df_exp_design = df_exp_design.merge(
            df_exp_slide[["slide_id"]],
            how="cross"
        )

        df_exp_design.to_csv(params.exp_design, index=False)

