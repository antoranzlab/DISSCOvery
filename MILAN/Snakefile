# ---------------------------------------------------------------------------
# 11 Cell Identification - Clustering analysis
# ---------------------------------------------------------------------------
CSV_11_DICT =  os.path.join(PROJECT_DIR, "output_cell_identification",
config["ci_node_id"], config["ci_version_id"], "annotation_dictionary.csv")

rule clustering_analysis:
    input:
        done=CONFUSION_MATRIX_DONE, 
    output:
        done=touch(CLUSTERING_ANALYSIS_DONE), 
    params:
        script=os.path.join(config["scripts"], "src/11_cell_identification/ClusteringAnalysis_updated.py"),
        csv_markers=os.path.join( PROJECT_DIR,"phenotypic_markers.csv"),
        csv_in=CSV_11_DATA_SAMPLED,
        pca=CSV_11_DATA_REDUCED_PCA,
        tsne=CSV_11_DATA_REDUCED_TSNE,
        umap=CSV_11_DATA_REDUCED_UMAP,
        phenograph=os.path.join(PATH_REDUCED_DATA, "phenograph.parquet"),
        kmeans=os.path.join(PATH_REDUCED_DATA, "kmeans.parquet"),
        som=os.path.join(PATH_REDUCED_DATA, "som.parquet"),
        anno_dict = CSV_11_DICT,
        gen_plots=config['generate_marker_plots'],
        out_dir=PATH_REDUCED_DATA,
        phenograph_map=os.path.join(PATH_REDUCED_DATA, "phenograph_mapped_clusters.parquet"),
        kmeans_map=os.path.join(PATH_REDUCED_DATA, "kmeans_mapped_clusters.parquet"),
        som_map=os.path.join(PATH_REDUCED_DATA, "som_mapped_clusters.parquet"),
        gen_spatial_plots=config['generate_spatial_plots'],
        points_per_plot= config['spatial_max_points.per_plot'],
        seed=config['seed'],
        
    log:
        os.path.join(PROJECT_DIR, "logs", "ci_clustering_analysis.log"),
    threads: 1
    shell:
        "python {params.script} "
        "--mode build "
        "--input.marker.list {params.csv_markers} "
        "--path.input.csv {params.csv_in} "
        "--path.input.pca {params.pca} "
        "--path.input.tsne {params.tsne} "
        "--path.input.umap {params.umap} "
        "--path.input.phenograph {params.phenograph} "
        "--path.input.kmeans {params.kmeans} "
        "--path.input.som {params.som} "
        "--path.annotation.dictionary {params.anno_dict} "
        "--generate.marker.plots {params.gen_plots} "
        "--path.output.folder {params.out_dir} "
        "--path.input.mapped.phenograph {params.phenograph_map} "
        "--path.input.mapped.kmeans {params.kmeans_map} "
        "--path.input.mapped.som {params.som_map} "
        "--generate.spatial.plots {params.gen_spatial_plots} "
        "--spatial.max.points.per.plot {params.points_per_plot} "
        "--selected.seed {params.seed} "
        "--update.heatmaps 0 "
        "--update.enrichment 0 "
        "--update.dr.plots 0 "
        "--update.spatial.plots 0 "
        "--write.json 0 "
        "--write.html 1 "
        "&> {log} "

