def all_generate_masks_flags(wildcards):
    jobs = get_generate_masks_jobs()
    return [
        os.path.join(PROJECT_DIR, "logs", f"generate_masks_{j}.done")
        for j in jobs
    ]

wildcard_constraints:
    job=r"\d+"

