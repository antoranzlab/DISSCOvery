        pixel_size=config["hs_pixel_size"],
        technology=config["technology"],
        method_dict=os.path.join(config["scripts"], "src/02_FFC/technology_channel_method_dictionary.csv"),
        output_corr=PATH_OUTPUT_02_FFC,
        output_templates=PATH_OUTPUT_02_FFC_TEMPLATES,
        output_csv=CSV_02_FFC_JOBLIST,
        output_meta=CSV_02_FFC_JOBLIST_METADATA,
    log:
        os.path.join(PROJECT_DIR, "logs", "ffc_joblist.log"),
    shell:
        "python {params.script} "
        "--input_path_tiles {params.tiles_dir} " 
        "--input_path_meta {params.tiles_dir} " 
        "--input_path_masks {params.path_masks} " 
        "--mask_pixel_size {params.pixel_size} " 
        "--input_method_dictionary {params.method_dict} " 
        "--acquisition_technology {params.technology} " 
        "--output_folder_corr {params.output_corr} " 
        "--output_folder_templates {params.output_templates} " 
        "--output_path_csv {params.output_csv} " 
        "--output_path_csv_metadata {params.output_meta} "
        "&> {log}"

# ---------------------------------------------------------------------------
# 02 FFC - Flat-field correction with Kask
# ---------------------------------------------------------------------------
def get_ffc_kask_jobs():
    df = pd.read_csv(checkpoints.ffc_joblist.get().output.joblist)
    df = df[df['method']=='KASK']
    return {
        str(i): {
            "input_path": row["input_path"],
            "input_meta": row["input_meta"],
            "input_mask": row["input_mask"],
            "mask_pixel_size": row["mask_pixel_size"],
            "output_path_corr": row["output_path_corr"],
            "output_path_templates": row["output_path_templates"],
            "channel": row["channel"],
            }
        for i, row in df.iterrows()
    }

def all_ffc_kask_job_ids(wildcards):
    return list(get_ffc_kask_jobs().keys())

def all_ffc_kask_flags(wildcards):
    jobs = get_ffc_kask_jobs()
    return [
        os.path.join(PROJECT_DIR, "logs", f"ffc_kask_{j}.done")
        for j in jobs
    ]

wildcard_constraints:
    job=r"\d+"

rule ffc_kask:
    input:
        joblist=CSV_02_FFC_JOBLIST,
    output:
        done=touch(os.path.join(PROJECT_DIR, "logs", "ffc_kask_{job}.done")),
    params:
        script=os.path.join(config["scripts"], "src/02_FFC/FFC_Kask.py"),
        tile=lambda wc: get_ffc_kask_jobs()[wc.job]["input_path"],
        meta=lambda wc: get_ffc_kask_jobs()[wc.job]["input_meta"],
        mask=lambda wc: get_ffc_kask_jobs()[wc.job]["input_mask"],
        px_size=lambda wc: get_ffc_kask_jobs()[wc.job]["mask_pixel_size"],
        out_corr=lambda wc: get_ffc_kask_jobs()[wc.job]["output_path_corr"],
        out_temp=lambda wc: get_ffc_kask_jobs()[wc.job]["output_path_templates"],
        channel=lambda wc: get_ffc_kask_jobs()[wc.job]["channel"],
        n_cores=config['n_cores_ffc'],
    log:
        os.path.join(PROJECT_DIR, "logs", "ffc_kask_{job}.log"),
    threads: 1
    shell:
        "python {params.script} "
        "--input_images {params.tile} "
        "--input_metadata {params.meta} "
        "--input_mask {params.mask} "
        "--pixel_size {params.px_size} "
        "--channel {params.channel} "
        "--output_path_corrected_tiles {params.out_corr} "
        "--output_path_templates {params.out_temp} "
        "--n_cores {params.n_cores} "
        "--skip_existing False "
        "&> {log} "

# Aggregator: forces checkpoint resolution and collects all per-job outputs
rule ffc_kask_done:
    input:
        all_ffc_kask_flags
    output:
        touch(FFC_KASK_DONE),
    log:
        os.path.join(PROJECT_DIR, "logs", "ffc_kask.log"),

# ---------------------------------------------------------------------------
# 02 FFC - BaSiC flat-field correction
# ---------------------------------------------------------------------------
def get_ffc_basic_jobs():
    df = pd.read_csv(checkpoints.ffc_joblist.get().output.joblist)
    df = df[df['method']=='BASIC']
    return {
        str(i): {
            "input_path": row["input_path"],
            "output_path_corr": row["output_path_corr"],
            "output_path_templates": row["output_path_templates"],
            "channel": row["channel"],
            }
        for i, row in df.iterrows()
    }

def all_ffc_basic_job_ids(wildcards):
    return list(get_ffc_basic_jobs().keys())

def all_ffc_basic_flags(wildcards):
    jobs = get_ffc_basic_jobs()
    return [
        os.path.join(PROJECT_DIR, "logs", f"ffc_basic_{j}.done")
        for j in jobs
    ]

wildcard_constraints:
    job=r"\d+"

rule ffc_basic:
    input:
        joblist=CSV_02_FFC_JOBLIST,
        ffc_kask_done=FFC_KASK_DONE,
    output:
        done=touch(os.path.join(PROJECT_DIR, "logs", "ffc_basic_{job}.done")),
    params:
        script=os.path.join(config["scripts"], "src/02_FFC/FFC_BaSiC.py"),
        tile=lambda wc: get_ffc_basic_jobs()[wc.job]["input_path"],
        out_corr=lambda wc: get_ffc_basic_jobs()[wc.job]["output_path_corr"],
        out_temp=lambda wc: get_ffc_basic_jobs()[wc.job]["output_path_templates"],
        channel=lambda wc: get_ffc_basic_jobs()[wc.job]["channel"],
        n_cores=config['n_cores_ffc'],
        fit=config['ffc_basic_n_fit_images'],
        device=config['ffc_basic_device'],
        seed=config['seed'] 
    log:
        os.path.join(PROJECT_DIR, "logs", "ffc_basic_{job}.log"),
    threads: 1
    shell:
        "python {params.script} "
        "--in_path {params.tile} "
        "--channel {params.channel} "
        "--out_path_corr {params.out_corr} "
        "--out_path_templates {params.out_temp} "
        "--n_write_workers {params.n_cores} "
        "--device {params.device} "
        "--n_fit_images {params.fit} "
        "--seed {params.n_cores} "
        "&> {log} "

# Aggregator: forces checkpoint resolution and collects all per-job outputs
rule ffc_basic_done:
    input:
        all_ffc_basic_flags
    output:
        touch(FFC_BASIC_DONE),
    log:
        os.path.join(PROJECT_DIR, "logs", "ffc_basic.log"),

