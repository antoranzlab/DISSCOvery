        ref_version=lambda wc: get_bb_concordance_jobs()[wc.job]["ref_version"],
    log:
        os.path.join(PROJECT_DIR, "logs", "bb_concordance_{job}.log"),
    threads: 1
    shell:
        "python {params.script} "
        "--input_path_BB {params.input_folder} "
        "--output_heatmap_path_html {params.output_html} "
        "--output_heatmap_path_json {params.output_json} "
        "--reference_round {params.ref_round} "
        "--reference_version {params.ref_version} "
