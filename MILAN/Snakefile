CLUSTER_MAPPING_FOLDER = os.path.join(
    PROJECT_DIR,
    "output_cell_identification",
    config["ci_node_id"],
    config["ci_version_id"],
    "cluster_mapping"
)

CLUSTERING_METHODS2 = ["phenograph", "kmeans", "som"]

wildcard_constraints:
    method="|".join(CLUSTERING_METHODS2)

# ---------------------------------------------------------------------------
# Parquet
# ---------------------------------------------------------------------------

def all_mapped_clustering_flags(wildcards):
    return expand(os.path.join(PROJECT_DIR, "logs", "ci_{method}_mapped_clusters_done.flag"),
        method=CLUSTERING_METHODS2)


rule mapped_clustering:
    input:
        data=os.path.join(PATH_REDUCED_DATA, "{method}.parquet"),
        done=CLUSTERING_DONE,
    output:
        clusters=os.path.join(PATH_REDUCED_DATA,"{method}_mapped_clusters.parquet"),
        done=touch(os.path.join(PROJECT_DIR,"logs", "ci_{method}_mapped_clusters_done.flag")),
    params:
        script=os.path.join(config["scripts"], "src/11_cell_identification/MapClusters.py"),
        csv_markers=os.path.join(PROJECT_DIR,"phenotypic_markers.csv"),
        umap=CSV_11_DATA_REDUCED_UMAP,
        umap_model=RDS_11_DATA_REDUCED_UMAP,
        knn=config["knn_n_neighbors"],
        full_data=CSV_11_DATA_NORM,
        high_pred=config["prediction_high_confidence"],
        medium_pred=config["prediction_medium_confidence"],
    log:
        os.path.join( PROJECT_DIR,"logs", "ci_mapped_clusters_{method}.log"),
    threads: 1
    shell:
        "python {params.script} "
        "--input.marker.list {params.csv_markers} "
        "--path.input.full.data {params.full_data} "
        "--path.input.umap {params.umap} "
        "--path.input.umap.model {params.umap_model} "
        "--path.input.cluster {input.data} "
        "--path.output.csv {output.clusters} "
        "--knn.n.neighbors {params.knn} "
        "--prediction.high.confidence {params.high_pred} "
        "--prediction.medium.confidence {params.medium_pred} "
        "&> {log} "


