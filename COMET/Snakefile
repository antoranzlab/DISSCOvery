    output:
        reduced_csv=CSV_11_DATA_REDUCED_TSNE,
        reduced_rds=RDS_11_DATA_REDUCED_TSNE,
        reduction_done = touch(REDUCTION_DONE),
    params:
        script=os.path.join(config["scripts"], "src/11_cell_identification/DimensionalityReduction.py"),
        data_sampled = CSV_11_DATA_SAMPLED,
        csv_markers=os.path.join(PROJECT_DIR, "phenotypic_markers.csv"),
        sample=config["sample_yes_or_no"],
        seed=config['seed']
    log:
        os.path.join(PROJECT_DIR, "logs", "ci_dim_reduction_tsne.log"),
    shell:
        "python {params.script} "
        "--input.marker.list {params.csv_markers} "
        "--path.input.csv {params.data_sampled} "
        "--path.output.csv {output.reduced_csv} "
        "--path.output.model {output.reduced_rds} "
        "--dimensionality.reduction.method tsne "
        "--selected.seed {params.seed} "
        "&> {log} "

