# ---------------------------------------------------------------------------
# 01 File parsing - Input QC
# ---------------------------------------------------------------------------
rule input_qc:
    input:
        indir=BASE_INPUT_DIR,
    output:
        txt=OUTPUT_01_QC_FILE,
    params:
        script=os.path.join(config["scripts"], "src/01_file_parser/comet_files_qc_processed.py"),
    log:
        os.path.join(PROJECT_DIR, "logs", "input_qc.log"),
    shell:
        "python {params.script} "
        "--input_path {input.indir} "
        "--output_txt {output.txt} "
        "&> {log}"

# ---------------------------------------------------------------------------
# 01 File parsing - Experimental design
# ---------------------------------------------------------------------------
rule experimental_design:
    input:
        indir=BASE_INPUT_DIR,
    output:
        rounds=CSV_01_EXP_DESIGN_ROUNDS,
        slides=CSV_01_EXP_DESIGN_SLIDES,
    params:
        script=os.path.join(config["scripts"], "src/01_file_parser/exp_design_comet.py"),
    log:
        os.path.join(PROJECT_DIR, "logs", "experimental_design.log"),
    shell:
        "python {params.script} "
        "--input_path {input.indir} "
        "--exp_design_rounds {output.rounds} "
        "--exp_design_slides {output.slides} "
        "&> {log}"

# ---------------------------------------------------------------------------
# 01 File parsing - Add slide ID
# ---------------------------------------------------------------------------
rule add_slide_id:
    input:
        slides=CSV_01_EXP_DESIGN_SLIDES,
    output:
        id_done = touch(SLIDE_ID_SELECTION_DONE),
    params:
        slide_id=config['slide_id']
    log:
        os.path.join(PROJECT_DIR, "logs", "add_slide_id.log"),
    run:
        import pandas as pd

        # Experimental design for slides
        df_exp_slide = pd.read_csv(input.slides)
        df_exp_slide['slide_id'] = params.slide_id

        df_exp_slide.to_csv(input.slides, index=False)

# ---------------------------------------------------------------------------
# 01 File parsing - Parse slide name
# ---------------------------------------------------------------------------
rule parse_name:
    input:
        done=SLIDE_ID_SELECTION_DONE,
    output:
        id_done = touch(PARSE_DONE),
    params:
        script=os.path.join(config["scripts"], "src/01_file_parser/parse_slide_names.py"),
        rounds=CSV_01_EXP_DESIGN_ROUNDS,
        slides=CSV_01_EXP_DESIGN_SLIDES,
    log:
        os.path.join(PROJECT_DIR, "logs", "parse_slide_name.log"),
    shell:
        "python {params.script} "
        "--path_input_exp_design_rounds {params.rounds} "
        "--path_input_exp_design_slides {params.slides} "
        "--path_output_exp_design_merged {params.rounds} "
        "&> {log}"

    
# ---------------------------------------------------------------------------
# 01 File parsing - Build data parsing joblist
# ---------------------------------------------------------------------------
checkpoint generate_joblist:
    input:
        done=PARSE_DONE
    output:
        joblist=CSV_01_DATA_PARSING,
    params:
        script=os.path.join(config["scripts"], "src/01_file_parser/comet_generate_csv_joblist.py"),
        indir=BASE_INPUT_DIR,
        tiles_dir=PATH_01_RAW_TILES,
        slide=CSV_01_EXP_DESIGN_SLIDES,
        rounds=CSV_01_EXP_DESIGN_ROUNDS,
        user=config['user_id'],
        project=config['project_id'],
    log:
        os.path.join(PROJECT_DIR, "logs", "parsing_joblist.log"),
    shell:
        "python {params.script} "
        "--path.input.folder {params.indir} "
        "--path.output.folder {params.tiles_dir} "
        "--path.input.slide.dictionary {params.slide} "
        "--path.exp.design.rounds.file {params.rounds} "
        "--user.id {params.user} "
        "--project.id {params.project} "
        "--path.output.csv {output.joblist} "
        "&> {log}"

# ---------------------------------------------------------------------------
# 01 File parsing - Run the extraction
# ---------------------------------------------------------------------------
def get_data_parsing_jobs():
    df = pd.read_csv(checkpoints.generate_joblist.get().output.joblist)
    return {
        str(i): {
            "input_path": row["input_path"],
            "output_folder": row["output_folder"],
            "project_id": row["project_id"],
            "user_id": row["user_id"],
            "input_slide_dictionary": row["input_slide_dictionary"],
            "exp_design_rounds_file": row["exp_design_rounds_file"],
        }
        for i, row in df.iterrows()
    }

def all_job_ids(wildcards):
    return list(get_data_parsing_jobs().keys())

def all_data_parsing_flags(wildcards):
    jobs = get_data_parsing_jobs()
    return [
        os.path.join(PROJECT_DIR, "logs", f"data_parsing_{j}.done")
        for j in jobs
    ]

wildcard_constraints:
    job=r"\d+"

rule parsing:
    input:
        joblist=CSV_01_DATA_PARSING,
    output:
        done=touch(os.path.join(PROJECT_DIR, "logs", "data_parsing_{job}.done")),
    params:
        script=os.path.join(config["scripts"], "src/01_file_parser/extract_lunaphore_ometiff_processed.py"),
        file=lambda wc: get_data_parsing_jobs()[wc.job]["input_path"],
        slide_dictionary=lambda wc: get_data_parsing_jobs()[wc.job]["input_slide_dictionary"],
        rounds_dictionary=lambda wc: get_data_parsing_jobs()[wc.job]["exp_design_rounds_file"],
        out_dir=lambda wc: get_data_parsing_jobs()[wc.job]["output_folder"],
        user=lambda wc: get_data_parsing_jobs()[wc.job]["user_id"],
        project=lambda wc: get_data_parsing_jobs()[wc.job]["project_id"],
        rounds=config['parse_rounds'],
        workers=config['num_workers']
    log:
        os.path.join(PROJECT_DIR, "logs", "data_parsing_{job}.log"),
    threads: 1
    shell:
        "python {params.script} "
        "--input_directory {params.file} "
        "--output_directory {params.out_dir} "
        "--slide_dictionary_file {params.slide_dictionary} "
        "--exp_design_rounds_file {params.rounds_dictionary} "
        "--user_id {params.user} "
        "--project_id {params.project} "
        # "--rounds {params.rounds} "
        "--n_workers {params.workers} "
        "&> {log} "

# Aggregator: forces checkpoint resolution and collects all per-job outputs
rule parsing_done:
    input:
        all_data_parsing_flags
    output:
        touch(EXTRACTION_DONE),
    log:
        os.path.join(PROJECT_DIR, "logs", "data_parsing_done.log"),


