        "&> {log} "

# ---------------------------------------------------------------------------
# 03 STS - Resize
# ---------------------------------------------------------------------------
def get_resize_sts_jobs():
    df = pd.read_csv(checkpoints.resize_sts_joblist.get().output.joblist)
    return {
        str(i): {
            "input_path_image": row["input_path_image"],
            "output_path_image": row["output_path_image"],
            "conversion_factor": row["conversion_factor"],
            }
        for i, row in df.iterrows()
    }

def all_resize_sts_job_ids(wildcards):
    return list(get_resize_sts_jobs().keys())

def all_resize_sts_flags(wildcards):
    jobs = get_resize_sts_jobs()
    return [
        os.path.join(PROJECT_DIR, "logs", f"resize_sts_{j}.done")
        for j in jobs
    ]

wildcard_constraints:
    job=r"\d+"

rule hard_stitching_sts:
    input:
        joblist=CSV_03_RESIZE_JOBLIST,
    output:
        done=touch(os.path.join(PROJECT_DIR, "logs", "resize_sts_{job}.done")),
    params:
        script=os.path.join(config["scripts"], "src/03_hard_stitching/01_resize_processed.py"),
        img=lambda wc: get_resize_sts_jobs()[wc.job]["input_path_image"],
        out=lambda wc: get_resize_sts_jobs()[wc.job]["output_path_image"],
        conversion_factor=lambda wc: get_resize_sts_jobs()[wc.job]["conversion_factor"],
    log:
        os.path.join(PROJECT_DIR, "logs", "resize_sts_{job}.log"),
    threads: 1
    shell:
        "python {params.script} "
        "--input_path_image {params.img} "
        "--output_path_image {params.out} "
        "--conversion_factor {params.conversion_factor} "
        "--skip_existing False "
        "&> {log} "

# Aggregator: forces checkpoint resolution and collects all per-job outputs
rule resize_sts_done:
    input:
        all_resize_sts_flags
    output:
        touch(RESIZE_STS_DONE),
    log:
        os.path.join(PROJECT_DIR, "logs", "resize_sts.log"),

